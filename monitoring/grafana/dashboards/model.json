          "legendFormat": "5xx"
        },
        {
          "refId": "B",
          "expr": "sum(rate(demo_predict_requests_total{status=~\"4..\"}[5m])) / sum(rate(demo_predict_requests_total[5m]))",
          "legendFormat": "4xx"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2
