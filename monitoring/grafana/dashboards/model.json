    {
      "id": 18,
      "title": "Redis · попадания и новые поиски / сек",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 30, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum by(result) (rate(demo_neighbor_cache_lookups_total[$__rate_interval]))", "legendFormat": "{{result}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "decimals": 3 }, "overrides": [] },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "id": 19,
      "title": "Qdrant · задержка поиска p95",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 30, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.95, sum by(le) (rate(demo_qdrant_query_duration_seconds_bucket[$__rate_interval])))", "legendFormat": "p95" }
