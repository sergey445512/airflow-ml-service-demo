        "defaults": {
          "unit": "short",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "calculate": false,
        "cellGap": 1,
        "color": {
          "mode": "scheme",
          "scheme": "Oranges",
          "steps": 64
        },
        "yAxis": {
          "axisPlacement": "left",
          "min": 0,
          "max": 1,
          "unit": "percentunit"
        },
        "legend": {
          "show": true
        },
        "tooltip": {
          "show": true
        }
      }
