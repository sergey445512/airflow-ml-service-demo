FROM python:3.12-slim@sha256:05cda9777409a9c3ffddd94a4c476b79f0769a0b4857f0c7ed9226b6800b0d6f

RUN pip install --no-cache-dir \
    "fastapi==0.136.3" "starlette==1.6.0" "httpx==0.28.1" \
    "uvicorn==0.52.4" "pydantic==2.13.5" \
    "requests==2.34.2" "mlflow==3.10.1" "scikit-learn==1.7.2" \
    "psycopg2-binary==2.9.11" "redis==6.4.0" \
    "prometheus-client==0.26.0" && pip check

RUN useradd --create-home --uid 10001 app
USER app
ENV PYTHONPATH=/opt/demo
WORKDIR /opt/demo
COPY --chown=app:app service/ ./service/
COPY --chown=app:app src/ ./src/
COPY --chown=app:app scripts/demo_traffic.py scripts/smoke_release.py \
    scripts/verify_stores.py scripts/verify_traffic.py scripts/test_metrics.py ./scripts/

ARG SOURCE_REVISION=local
ENV DEMO_CODE_REVISION=${SOURCE_REVISION}
LABEL org.opencontainers.image.revision=${SOURCE_REVISION}
